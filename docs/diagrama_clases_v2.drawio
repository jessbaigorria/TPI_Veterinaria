        <mxCell id="n_state" value="Cada estado redefine solo sus transiciones&lt;br&gt;válidas; las demás usan la versión base,&lt;br&gt;que lanza TransicionInvalidaError.&lt;br&gt;&lt;br&gt;Extraída → Empaquetada → En tránsito →&lt;br&gt;Recibida → Analizada&lt;br&gt;En tránsito → Rechazada (precinto roto)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b8a24a;" parent="1" vertex="1">
